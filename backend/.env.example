# Copy to .env for local runs (never commit the real file — see ../.gitignore), or set
# these as environment variables / secrets in your host's dashboard (Render, Railway, ...).
# Every value here is OPTIONAL — the pipeline and API run completely without any of them.

# Enables the GenAI DDMA report narrative via Groq (fast, generous free tier — get a key
# at console.groq.com). Checked first; falls back to Anthropic, then to a deterministic
# template if neither is set or the call fails for any reason.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Secondary/alternative provider for the report narrative.
ANTHROPIC_API_KEY=
NIRNAY_NARRATIVE_MODEL=claude-sonnet-5

# Set automatically by Render/Railway/Fly — only needed if you run the Docker image
# yourself locally (docker run -e PORT=8000 ...).
PORT=8000
