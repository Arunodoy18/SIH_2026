# Copy to .env.local for local overrides, or set as a Netlify site environment variable.
# URL of the deployed backend API, NO trailing slash. Leave unset for local dev — Vite's
# dev server proxies /api to http://127.0.0.1:8000 automatically (see vite.config.ts).
VITE_API_BASE_URL=https://nirnay-backend.onrender.com
